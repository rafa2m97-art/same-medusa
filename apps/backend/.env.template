# Envia (Etapa 8 — Package Planning + Shipping). Confirmado por SSH
# 2026-10-05: en producción real HOY vive en WordPress wp_options
# (same_envia_api_key), NUNCA en un .env — aquí se migra a variable de
# entorno siguiendo la misma convención que el resto del proyecto.
# Placeholders solo; nunca valores reales en este repo.
# Hosts reales confirmados: producción https://api.envia.com, sandbox
# https://api-test.envia.com (ver same_get_envia_shipping_api_base_url
# real) -- usar el sandbox aquí y en local/staging, nunca producción.
ENVIA_API_KEY=replace-with-envia-api-key
ENVIA_BASE_URL=https://api-test.envia.com

# Candado duro de compra de guía real (Etapa 9, plan §38). Las TRES
# deben ser explícitamente "true" Y el host debe ser de producción
# para que EnviaLabelAdapter compre una guía real -- ninguna variable
# sola activa un gasto real por accidente. Default seguro: todo "false".
ENVIA_ENVIRONMENT=sandbox
ENVIA_LABEL_PURCHASE_ENABLED=false
ENVIA_PRODUCTION_UNLOCKED=false
